<div class="flex items-center justify-center mb-6 h-full">
  {% if section.settings.not_found_image != blank %}
    <div class="not-found-image">
      <img 
        src="{{ section.settings.not_found_image | image_url: width: 800 }}" 
        alt="{{ 'templates.404.not_found_image_alt' | t }}" 
        height="auto" 
        width="auto" 
      />
    </div>
  {% endif %}


  <h1>{{ section.settings.title }}</h1>

  <p>{{ section.settings.subtext }}</p>
</div>

{% schema %}
  {
    "name": "Template 404",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Título",
        "default": "Página não encontrada teste titulo"
      },
      {
        "type": "text",
        "id": "subtext",
        "label": "Texto",
        "default": "A página que você está procurando não existe. teste subtexto"
      },
      {
        "type": "image_picker",
        "id": "not_found_image",
        "label": "Imagem da página 404"
      }
    ]
  }
{% endschema %}
